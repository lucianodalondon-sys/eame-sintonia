{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "POTE_INTELLIGENCE_CASCO/v2",
 "title": "O pote v2 unico — uma corrida da Intelligence, um compartimento por ferramenta",
 "description": "FORMA do contrato. A LEI inteira (NAO SEI com base, uso que exige tempo, serie medida, lugar da fonte) e de conferir_pote em pacote/pote_intelligence_casco.py; tests/test_pote_v2_unico.py reprova se este schema e o codigo divergirem. Documento: docs/intelligence/pote-v2/CONTRATO-POTE-V2.md.",
 "type": "object",
 "required": ["SCHEMA", "MARCA", "INTELLIGENCE_RUN_ID", "SOURCE_HEAD", "CORTE", "RESULT_STATE",
              "RUN_SCHEMA", "CORRIDA_SINTETICA", "ENTRADA", "LEITURA_DE_COMPATIBILIDADE", "REVISAO_DO_CONTRATO", "LEI", "COMPARTIMENTOS",
              "LACUNAS_SEM_COMPARTIMENTO", "RECUSADOS"],
 "properties": {
  "SCHEMA": {"const": "POTE_INTELLIGENCE_CASCO/v2"},
  "MARCA": {"enum": ["EXPERIMENTAL · NAO_PARA_CLIENTE", "EXPERIMENTAL · PREVIEW_NAO_PRODUCAO"]},
  "NAO_PARA_CLIENTE": {"const": true},
  "EIXOS": {"const": "EIXOS/v1 (K2 · 2026-10-01)"},
  "AMBIENTE": {"const": "PREVIEW_NAO_PRODUCAO"},
  "PRODUCAO": {"const": false},
  "INTELLIGENCE_RUN_ID": {"type": "string", "minLength": 1, "not": {"const": "NAO SEI"}},
  "ENTRADA": {"enum": ["CORRIDA", "PAYLOAD_V1"]},
  "LEITURA_DE_COMPATIBILIDADE": {"type": "array", "items": {"type": "string"}},
  "REVISAO_DO_CONTRATO": {"const": "v2 + LIGACAO_ADAMA/v1 (D123, 2026-09-27)"},
  "COMPARTIMENTOS": {
   "type": "object",
   "required": ["meeting", "future", "windows", "market", "voices", "competitors", "science", "portfolio",
                "archive", "sources", "field", "casa"],
   "additionalProperties": {"$ref": "#/$defs/compartimento"}
  },
  "RECUSADOS": {"type": "array", "items": {"type": "object", "required": ["COMPARTIMENTO", "OBJETO_ID", "MOTIVO"]}}
 },
 "$defs": {
  "compartimento": {
   "type": "object",
   "required": ["MARCA", "COMPARTIMENTO", "NOME_IT", "VISTAS_DO_CASCO", "ESPECIES_ADMITIDAS",
                "CONTRATO_CHAVES", "OBJETOS", "LACUNAS", "UNIVERSO", "ESTADO", "PORQUE_VAZIO", "PORQUE_TEXTO",
                "RECUSADOS_AQUI"],
   "properties": {
    "ESTADO": {"enum": ["COM_OBJETOS", "VAZIO"]},
    "OBJETOS": {"type": "array", "items": {"$ref": "#/$defs/objeto"}}
   }
  },
  "objeto": {
   "type": "object",
   "required": ["MARCA", "NAO_PARA_CLIENTE", "COMPARTIMENTO", "OBJETO_ID", "ESPECIE", "ESPECIE_DITA_POR", "ESTADO",
                "CHAVES", "CHAVES_NAO_SEI", "FORA_DO_CONTRATO", "PORQUE", "CONTRADIZ", "INCERTEZA", "RESULTADO",
                "USO_EXIGE_TEMPO", "PROVA", "CORRIDA_SINTETICA", "LIGACAO_ADAMA"],
   "properties": {
    "ESPECIE": {"enum": ["SINAL", "FATO_PRESENTE_SOBRE_O_FUTURO", "CROSSING", "FINDING", "OPORTUNIDADE",
                         "RENDIMENTO_DE_FONTE"]},
    "ESPECIE_DITA_POR": {"enum": ["INTELLIGENCE", "CONTRATO_V1"]},
    "ESTADO": {"enum": ["EXPERIMENTAL_CANDIDATE", "LIBERADO_PARA_CLIENTE"]},
    "NAO_PARA_CLIENTE": {"type": "boolean"},
    "LIBERACAO": {"enum": ["LIBERADO_PARA_CLIENTE", "NAO_PARA_CLIENTE"]},
    "RESULTADO": {"enum": ["NAO", "NAO_TRATAR_AGORA", "NO_DEFENSIBLE_ACTION_YET", "NAO SEI"]},
    "USO_EXIGE_TEMPO": {"type": "boolean"},
    "ENTITY_SOURCE": {"type": "string"},
    "LOCATION_SOURCE": {"type": "string"},
    "PROVA": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/prova"}},
    "LIGACAO_ADAMA": {"$ref": "#/$defs/ligacao"},
    "MERCADO": {
     "type": "object",
     "required": ["LEITURA", "PORQUE", "PONTOS", "UNIDADE", "SERIE"],
     "properties": {
      "LEITURA": {"enum": ["SERIE_MEDIDA", "SINAL_SOLTO"]},
      "SERIE": {"type": "array", "items": {"type": "object", "required": ["PERIOD", "PRICE", "UNIT"]}}
     }
    }
   }
  },
  "ligacao": {
   "description": "D123. Calculada SO por motor/porta_da_referencia.py (ligacao_adama) e selada; a LEI (selo, AUTORIZADO so com bula lida em LINHA_DA_TABELA/BLOCO_DA_CULTURA, ADAMA_SEM_PRODUTO so com leitura completa, travas INT-LAW-145/076, D116) e de PORTA.conferir_ligacao.",
   "type": "object",
   "required": ["CONTRATO", "CALCULADA_POR", "ESTADO", "FALTA", "PERGUNTA", "VEM_DE", "CARIMBO", "PRODUTOS_ADAMA",
                "CONCORRENTES_MESMA_SUBSTANCIA", "BULAS_A_LER", "NAO_PROVA", "CONTA_COMO_FONTE_INDEPENDENTE",
                "CATALOGO_E_AUTORIZACAO", "SELO"],
   "properties": {
    "CONTRATO": {"const": "LIGACAO_ADAMA/v1"},
    "CALCULADA_POR": {"const": "motor/porta_da_referencia.py"},
    "ESTADO": {"enum": ["AUTORIZADO_BULA_LIDA", "A_CONFIRMAR", "SO_CULTURA", "ADAMA_SEM_PRODUTO", "NAO_SEI"]},
    "FALTA": {"type": "array", "items": {"enum": ["CULTURA", "PROBLEMA", "SUBSTANCIA", "REFERENCIA"]}},
    "CONTA_COMO_FONTE_INDEPENDENTE": {"const": false},
    "CATALOGO_E_AUTORIZACAO": {"const": false},
    "PRODUTOS_ADAMA": {"type": "array", "items": {"type": "object",
                        "required": ["PRODUTO", "REGISTRO", "BULA", "ESTADO"]}},
    "BULAS_A_LER": {"type": "array", "items": {"type": "object", "required": ["EMPRESA", "REGISTRO", "BULA", "PORQUE"]}},
    "SELO": {"type": "string", "minLength": 64}
   }
  },
  "prova": {
   "type": "object",
   "required": ["ITEM_ID", "RAW_OBSERVATION_ID", "SOURCE_ID", "DOCUMENT_ID", "CORRIDA_UPSTREAM", "URL", "URL_BASE",
                "PUBLISHED_AT", "PUBLISHED_AT_BASE", "COLHIDO_EM", "FACT_TIME", "RAW_SHA256", "RAW_STORAGE_PATH",
                "G0", "ADMITIDA_POR", "INTELLIGENCE_RUN_ID"],
   "properties": {
    "ADMITIDA_POR": {"enum": ["G0_PASSOU", "FUTURO_POR_DESENHO", "USO_SEM_TEMPO", "PONTE_V1"]}
   }
  }
 }
}
