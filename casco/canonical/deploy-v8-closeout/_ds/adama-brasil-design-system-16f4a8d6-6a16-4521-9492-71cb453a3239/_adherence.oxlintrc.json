{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:BrownLL|Aleo))/i]",
        "message": "Font not provided by the design system. Available: BrownLL, Aleo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|dot|outline|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, size, dot, outline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|corporate-green|earth|crop-enhancement|weed-control|disease-control|pest-control|success|warning|info|error)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'corporate-green' | 'earth' | 'crop-enhancement' | 'weed-control' | 'disease-control' | 'pest-control' | 'success' | 'warning' | 'info' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|color|disabled|fullWidth|iconLeft|iconRight|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, color, disabled, fullWidth, iconLeft, iconRight, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|ghost|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'ghost' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:corporate|crop-enhancement|weed-control|disease-control|pest-control|earth|white)$/]",
        "message": "<Button> color must be one of 'corporate' | 'crop-enhancement' | 'weed-control' | 'disease-control' | 'pest-control' | 'earth' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|padding|color|hoverable|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, padding, color, hoverable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|elevated|outline|filled)$/]",
        "message": "<Card> variant must be one of 'default' | 'elevated' | 'outline' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg|xl)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:crop-enhancement|weed-control|disease-control|pest-control|corporate-green|earth)$/]",
        "message": "<Card> color must be one of 'crop-enhancement' | 'weed-control' | 'disease-control' | 'pest-control' | 'corporate-green' | 'earth'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|size|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<ProductIcon> doesn't accept that prop. Declared props: category, size, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductIcon'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:crop-enhancement|weed-control|disease-control|pest-control|corporate)$/]",
        "message": "<ProductIcon> category must be one of 'crop-enhancement' | 'weed-control' | 'disease-control' | 'pest-control' | 'corporate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|category|size|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, category, size, onRemove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:crop-enhancement|weed-control|disease-control|pest-control|corporate|earth)$/]",
        "message": "<Tag> category must be one of 'crop-enhancement' | 'weed-control' | 'disease-control' | 'pest-control' | 'corporate' | 'earth'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Tag> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
