.loader {
	position: relative;
	height: 70px;
	width: 70px;
	margin: 0 auto
}

.loader-wrapper {
	display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-align: center;
    -webkit-align-items: center;
    -ms-flex-align: center;
    align-items: center;
}

.loader-wrapper--page {
	min-height: 30vh
}

.loader-icons {
	width: 52px;
	height: 52px;
	position: absolute;
	left: 9px;
	top: 9px;
	overflow: hidden;
	border-radius: 50%
}

.loader-icons .icon {
	display: inline-block;
	font-size: 36px;
	line-height: 52px;
	position: absolute;
	left: 8px;
	-webkit-animation: icon-up 1s .7s infinite ease;
	animation: icon-up 1s .7s infinite ease
}

.inverted-color .loader-icons .icon {
	color: #fff
}

.loader-icons .icon--one {
	top: 0
}

.loader-icons .icon--two {
	top: 52px
}

.loader-circle-out {
	height: 70px;
	width: 70px;
	border-radius: 50%;
	border: 2px solid transparent;
	border-top-color: #003c7f;
	position: absolute;
	top: 0;
	left: 0;
	-webkit-animation: rotate-circle-out 1s infinite linear;
	animation: rotate-circle-out 1s infinite linear
}

.inverted-color .loader-circle-out {
	border-top-color: #fff
}

.loader-circle-in {
	height: 58px;
	width: 58px;
	border-radius: 50%;
	border: 2px solid transparent;
	border-top-color: #870042;
	position: absolute;
	top: 6px;
	left: 6px;
	-webkit-transform: rotate(15deg);
	transform: rotate(15deg);
	-webkit-animation: rotate-circle-in 1s infinite cubic-bezier(.25, .1, .7, .9);
	animation: rotate-circle-in 1s infinite cubic-bezier(.25, .1, .7, .9)
}

.inverted-color .loader-circle-in {
	border-top-color: #fff
}

@-webkit-keyframes rotate-circle-out {
    to {
        -webkit-transform: rotate(360deg);
        transform: rotate(360deg)
    }
}

@keyframes rotate-circle-out {
    to {
        -webkit-transform: rotate(360deg);
        transform: rotate(360deg)
    }
}

@-webkit-keyframes rotate-circle-in {
    to {
        -webkit-transform: rotate(720deg);
        transform: rotate(720deg)
    }
}

@keyframes rotate-circle-in {
    to {
        -webkit-transform: rotate(720deg);
        transform: rotate(720deg)
    }
}

@-webkit-keyframes icon-up {
    50% {
        -webkit-transform: translate(0,-52px);
        transform: translate(0,-52px)
    }

    50.1% {
        -webkit-transform: translate(0,0);
        transform: translate(0,0)
    }
}

@keyframes icon-up {
    50% {
        -webkit-transform: translate(0,-52px);
        transform: translate(0,-52px)
    }

    50.1% {
        -webkit-transform: translate(0,0);
        transform: translate(0,0)
    }
}

@keyframes spin{
    0%
    {
        transform:rotate(0);
        -webkit-transform:rotate(0)
    }
    100%{
        transform:rotate(360deg);
        -webkit-transform:rotate(360deg)
    }
}

.pull-to-refresh.on.waiting .loader{
    animation:spin 1.5s linear infinite;
    -webkit-animation:spin 1.5s linear infinite
}
.pull-to-refresh.on:not(.waiting){
    animation:chiusura .3s ease-out;
    -webkit-animation:chiusura .3s ease-out
}
.pull-to-refresh .loader{
    border:2px solid #AD9A88;
    border-top:2px solid #356E89;
    border-radius:50%;
    width:40px;
    height:40px;
    position:relative;
    top:20px;
    margin:0 auto;
    transform:translateZ(0);
    -webkit-transform:translateZ(0)
}
.loader-container{
    width: 100%;
    margin: 0 auto;
    min-height: 100%;
    display: table;
    z-index: 100;
    top: 0px;
}
.loader-container .loader{
    border-color:#fff #356E89 #356E89
}
.loader-container .icon-24{
    color:#fff
}
.loader-container .wrap{
    display:table-cell;
    vertical-align:middle
}
.loader-container .loader{
    border:2px solid #AD9A88;
    border-top:2px solid #356E89;
    border-radius:50%;
    width:80px;
    height:80px;
    position:relative;
    top:8px;
    margin:0 auto;
    transform:translateZ(0);
    -webkit-transform:translateZ(0);
    animation:spin 1.5s linear infinite;
    -webkit-animation:spin 1.5s linear infinite;
}
.loader-container .logo{
    position:relative;
    top:-55px;
    width:auto;
    text-align:center;
    font-size:44px;
    color:#356E89
}

.carousel-wrapper > .col.scrolling-item .pod-card {
    /*match solo se non è partito lo slider */
    max-width:250px;
}

body.backgroundAdv {
    background-color: #212121;
}

.player-frame {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1030;
    height: 60px;
    background: #f2f2f2;
    box-shadow: 0 -4px 20px 0 rgba(0,0,0,.4);
    -webkit-transition: all .2s ease-in-out;
    transition: all .2s ease-in-out
}

@media (prefers-reduced-motion:reduce) {
    .player-frame {
        -webkit-transition: none;
        transition: none
    }
}

@media (min-width: 768px) {
    .player-frame {
        height:70px
    }
}

@media (min-width: 1024px) {
    .player-frame {
        height:90px!important;
        box-shadow: 0 -1px 20px 0 rgba(0,0,0,.15)
    }
}

.is-player-in .player-frame {
    display: block
}

.is-player-expanded .player-frame {
    height: 150px
}

@media (min-width: 768px) {
    .is-player-expanded .player-frame {
        height:160px
    }
}

@media (max-width: 1024px ) {
  .pod-slider .slick-track .slick-slide .carousel-slide {
    height: 100%;
  }
}

/* videopodcast */



@-webkit-keyframes popout {
    from {
      bottom: -100%;
    }
    to {
      bottom: 10px;
    }
  }
  
  @keyframes popout {
    from {
      bottom: -100%;
    }
    to {
      bottom: 10px;
    }
  }

  .is-playing .pod-card-data  .icon-play:before{
    content: "";
  }

  .vpPlayer .player{
     position: fixed!important;
     bottom: 0px;
     background:white;
     width:100%;
     color: black;
    left:0px;
    /* così alto per andare sopra a playercontainer in maximize che a sua volta deve andar sopra la testata sticky" */
    z-index:8100;
}
@font-face {
    font-family: icon24plus-player;
    src: url(data:application/x-font-ttf;charset=utf-8;base64,) format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: block
}

.vpPlayer [class*=" icon-"], .pod-det-data .vpPlayer [class^=icon-], .pod-det-data .s24_player .icon{
    font-family: icon24plus-player!important
}


.vpPlayer .icon-player-play:before {
    content: ""!important;
}
.vpPlayer .icon-player-pause:before {
    content: ""
}

.vpPlayer {
    width:100%;

}

.is-player-in .mediaContainer .vpPlayer {
    display:block;
}

.vpPlayer .playerContainer:before{
    content:"";
    display:block;
    padding-top:56.25%;
}

.mediaContainer{
    position:relative;
}
/* .mediaContainer:after{
    display: block;
    content: "";
    padding-bottom:56.25%;
}
 */
.vpPlayer{
    position:absolute;
    top:18px;
}
.vpPlayer .playerContainer video-js{
    position:absolute;
    top:0px;
    left:0px;
    width:100%;
    height: 100%;
}
.vpPlayer .playerContainer.picInPic, .s24_player.playerContainer.picInPic {
    position:fixed;
    bottom: 90px;
    right:0px;
    width:530px;
    height:auto;
    z-index:200;
    -webkit-animation: popout 0.5s;
    animation: popout 0.5s;
}



.playerContainer {
    position: relative;
}
.playerContainer .controls {
    position:absolute;
    top:10px;
    right:10px;
}
.playerContainer .controls .player-inline-item:not(:last-child){
    margin-right:10px;
}
.playerContainer .controls .player-inline-item button{
    width:24px;
    height:24px;
    background:transparent;
    color: #fff;
}
.playerContainer .controls .player-inline-item button .icon{
    line-height:25px;
}

.playerContainer .controls .icon {
    color: #fff;
}

.vpPlayer .player-inline-item button.is-active .icon{
    color: rgba(0,153,255);
}

.vpPlayer .player{
    background: #f2f2f2;
}

/* video maximized */
body.video-maximized-in {
    overflow:hidden;
}
.playerContainer.maximized, .playerContainer.maximized.picInPic {
    position:fixed;
    bottom: 90px;
    right:0px;
    width:100%;
    height:calc(100% - 90px);
    z-index:8000;
}



.playerContainer.maximized .videoContainer.teleported{
    width:100%;
    height:100%;
}
.playerContainer.maximized .videoContainer.teleported:before{
    padding:0;
}

.playerContainer.maximized .controls {
    top:10px;
}
.playerContainer.maximized .player-inline-item:not(:last-child){ 
    margin-right:15px;
}

.playerContainer.maximized .controls .player-inline-item button{
    width:40px;
    height:40px;
    background: rgba(0, 0, 0, 0.25);
    border:50%;
}

.playerContainer.maximized .controls .player-inline-item button .icon{
    line-height:25px;
}


/* big play button */
.vjs-big-play-button {
    display:none!important; /* quello di default */
}

.vpPlayer.s24_player .big-play-btn, .s24_player.playerContainer .teleported .big-play-btn, .coverImage  .big-play-btn {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    position:absolute;
    width: 2em;
    height: 2em;
    line-height: 2em;
    border: none;
    border-radius: 50%;
    font-size: 3.5em;
    background-color: rgba(0,153,255,.45);
    color: #fff;
    -webkit-transition: border-color .4s,outline .4s,background-color .4s;
    -moz-transition: border-color .4s,outline .4s,background-color .4s;
    -ms-transition: border-color .4s,outline .4s,background-color .4s;
    -o-transition: border-color .4s,outline .4s,background-color .4s;
    transition: border-color .4s,outline .4s,background-color .4s;
}

.s24_player.playerContainer .teleported .big-play-btn .icon,  .coverImage  .big-play-btn .icon {
    font-size: 1em;
    line-height: 2em;
}

.vpPlayer.s24_player .big-play-btn:hover,  .coverImage  .big-play-btn:hover {
    background-color: rgba(0,153,255,1);

}

.vpPlayer.s24_player .big-play-btn span,  .coverImage  .big-play-btn span {
    font-size:1.2em;
    line-height: 1.6em;
}

.vpPlayer input.bar-line.bar-line--complete {
    height:4px;
}

/* input range track */
.vpPlayer .bar-line.bar-line--complete:before {
    content: none;
}
.vpPlayer input[type="range"] {
    width:100%;
    position:absolute;
    top:-3px;
    left:0px;
    overflow:hidden;
    background: transparent;
	color: #000;
    cursor: pointer;
	--thumb-height: 0.6em;
	--thumb-width: 0.5em;
	--track-height: 0.125em;
	--track-color: rgba(15, 15, 15, 0.2);
	--brightness-hover: 180%;
	--brightness-down: 80%;
	--clip-edges: 0.125em;
}

.vpPlayer input[type="range"],
.vpPlayer input[type="range"]::-webkit-slider-runnable-track,
.vpPlayer input[type="range"]::-webkit-slider-thumb {
	-webkit-appearance: none;
	transition: all ease 100ms;
	height: var(--thumb-height);
}

.vpPlayer input[type="range"]::-webkit-slider-runnable-track,
.vpPlayer input[type="range"]::-webkit-slider-thumb {
	position: relative;
}

.vpPlayer input[type="range"]::-webkit-slider-thumb {
	--thumb-radius: calc((var(--thumb-height) * 0.5) - 1px);
	--clip-top: calc((var(--thumb-height) - var(--track-height)) * 0.5 - 0.5px);
	--clip-bottom: calc(var(--thumb-height) - var(--clip-top));
	--clip-further: calc(100% + 1px);
	--box-fill: calc(-100vmax - var(--thumb-width, var(--thumb-height))) 0 0
		100vmax #09f;

	width: var(--thumb-width, var(--thumb-height));
	background: linear-gradient(currentColor 0 0) scroll no-repeat left center /
		50% calc(var(--track-height) + 1px);
	background-color: currentColor;
	box-shadow: var(--box-fill);
	border-radius: var(--thumb-width, var(--thumb-height));

	clip-path: polygon(
		100% -1px,
		var(--clip-edges) -1px,
		0 var(--clip-top),
		-100vmax var(--clip-top),
		-100vmax var(--clip-bottom),
		0 var(--clip-bottom),
		var(--clip-edges) 100%,
		var(--clip-further) var(--clip-further)
	);
}

input[type="range"]::-webkit-slider-runnable-track {
	background: linear-gradient(var(--track-color) 0 0) scroll no-repeat center / 100% calc(var(--track-height) + 1px);
}


/* === Firefox specific styles === */
input[type="range"],
input[type="range"]::-moz-range-track,
input[type="range"]::-moz-range-thumb {
	appearance: none;
	transition: all ease 100ms;
	height: var(--thumb-height);
}

input[type="range"]::-moz-range-track,
input[type="range"]::-moz-range-thumb,
input[type="range"]::-moz-range-progress {
	background: #09f;
}

input[type="range"]::-moz-range-thumb {
	background: currentColor;
	border: 0;
	width: var(--thumb-width, var(--thumb-height));
	border-radius: var(--thumb-width, var(--thumb-height));
}

input[type="range"]:active::-moz-range-thumb {
	cursor: grabbing;
}

input[type="range"]::-moz-range-track {
	width: 100%;
	background: var(--track-color);
}

input[type="range"]::-moz-range-progress {
	appearance: none;
	background: #09f;
	transition-delay: 30ms;
}

input[type="range"]::-moz-range-track,
input[type="range"]::-moz-range-progress {
	height: calc(var(--track-height) + 1px);
	border-radius: var(--track-height);
}




/* full screen mode */


.vpPlayer .backdrop, .mediaContainer .backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: rgba(29, 29, 29, 0.6);
    z-index: 40;
}

.is-fullscreen-in .vpPlayer{
    position:relative;
}
.is-fullscreen-in .vpPlayer > div, .is-fullscreen-in .vpPlayer .playerContainer {
    width:100%;
    height:100%;
    bottom:0px;
}
.is-fullscreen-in .vpPlayer .player{
    display:none;
    background: transparent;
    color:#fff;
    height:1px;
    bottom:179px;
    position:absolute;
    overflow:visible;
}

.is-fullscreen-in .vpPlayer .player .playing{ 
    width:auto;
    height:auto;
    padding-top:0px;
}

.is-fullscreen-in .vpPlayer .player .playing:after{
    content:none;
} 

.is-fullscreen-in .vpPlayer .player .playing-episodeNumber {
    font-size:0.875rem;
    opacity: 0.6;
    line-height:16px;
}


.is-fullscreen-in .vpPlayer .player .playing-serie {
    font: size 1rem;
    line-height: 1rem;
}
.is-fullscreen-in .vpPlayer .player .playing-title {
    font-size:2rem;
    line-height:2.25rem;
    margin-bottom:8px;
}
.is-fullscreen-in .vpPlayer .player .playing .marquee-scroll{
    animation:none;
    -webkit-animation: none;
    position:static;
}

.is-fullscreen-in .vpPlayer .player .playing .marquee {
    overflow:visible;
}

.is-fullscreen-in .vpPlayer .player .player-controls{
    position:absolute;
    top:110px;
    left:30px;
    right:30px;
}

.is-fullscreen-in .vpPlayer .player .player-controls .bar-line--complete:before{
    background: #0F0F0F;
}

.is-fullscreen-in .vpPlayer .player .player-controls .bar-line--played ,.is-fullscreen-in .vpPlayer .player .player-controls .bar-line--played .bar-line-cursor {
    background:#fff;
}
.is-fullscreen-in .vpPlayer .big-play-btn{
    z-index:300;
}

.is-fullscreen-in .playerContainer .controls {
    position:fixed;
    top:15px;
    bottom:auto;
    left:auto;
    right:15px;
    z-index:300;
    display:none;
}
.is-fullscreen-in .playerContainer .controls .player-inline-item:not(:last-child){
    margin-right:10px;
}
.is-fullscreen-in .playerContainer .controls .player-inline-item button{
    width:36px;
    height:36px;
    line-height:36px;
    
}
.is-fullscreen-in .playerContainer .controls .player-inline-item button .icon{
    line-height:36px;
}
.is-fullscreen-in .vpPlayer  .player-btn, .is-fullscreen-in .vpPlayer  .player-tools-btn{
    background: rgba(255,255,255,.1)!important;
    border-radius:50%;
    color: #fff!important;
    
}

.is-fullscreen-in .vpPlayer .player-btn-wrapper {
    position:fixed;
    left:50%;
    transform: translate(-50%, 0);
    top: 19px;
}

.is-fullscreen-in .vpPlayer .player-btn--main{
    color: #000;
    background: #fff;
}

.is-fullscreen-in .vpPlayer .player-tools {
    top: auto;
    right: 30px;
    top: 121px;
}
.is-fullscreen-in .vpPlayer .player-tools-btn-label {
    display:none;
}

.is-fullscreen-in .vpPlayer .player-tools-btn{
    border:0px;
    width:36px;
    height:36px;
    padding-top:0px;
}
.is-fullscreen-in .vpPlayer .player-tools-btn .icon{
    position:static;
}
.is-fullscreen-in .vpPlayer .player-tools-item:not(:last-child){
    margin-right:15px;

}


.is-fullscreen-in .vpPlayer .show-controls{
    display:block;
}

.is-fullscreen-in .vpPlayer input[type="range"] {
    color: #fff;
}

.mediaContainer.no-video:after, .mediaContainer.pip-only:after  {
    padding-bottom:0;

}

.mediaContainer.no-video .videoContainer video-js{
    position:fixed;
    bottom: -10px;
    left: -10px;
    width:10px;
    height:10px;
}

.mediaContainer.no-video .big-play-btn {
    display:none!important;
}

.mediaContainer.no-video .playerContainer:before, .mediaContainer.pip-only .playerContainer:before {
    padding:0;
}

.mediaContainer.no-video .playerContainer .controls {
    display:none;
}

.mediaContainer.no-video .playerContainer.picInPic{
    width:1px;
    height:1px;
}

.mediaContainer.pip-only .playerContainer.picInPic:before{
    padding-top:56.25%;
}

/* playlist */
.s24_player.vpPlayer .player-inline-item--playlist {
    display:block;
}
.video-placeholder {
    background-color: #1d1d1d;
}
.teleported.videoContainer{
    position:relative;
}
.teleported.videoContainer:before, .video-placeholder:before {
    content: " ";
    padding-top: 56.25%;
    display:block;
}

.teleported.videoContainer .video-js {
    position: absolute;
    top: 0;
    left: 0;
    width:100%;
    height:100%;
}

.teleported .big-play-btn {
    text-align: center;
    line-height: 2.2em;
}

.icon-player-vid-on:before{content:""}
.icon-player-vid-off:before{content:""}
.icon-player-maximize-vid:before{content:""}
.icon-player-minimize-vid:before{content:""}
.icon-player-full-screen-vid:before{content:""}
.icon-player-full-screen-vid-exit:before{content:""}

/*fix posizione button */
button.pod-card-act {
    position:absolute;
    top:0px;
    left:0px;
    width:48px;
    height:48px;
}

/* per video in foglia: */
.s24_player_videopart  + .pod-det-txt {
    margin-top:20px;
}

.coverImage {
    position:relative;
    text-align: center;
}
.coverImage img {
    width:100%;
    height:100%;
}



@media (max-width: 1023px) {
    .s24_player .player{
        height:70px!important;
        padding-bottom:70px!important;
    }

    .s24_player .player .player-controls {
        display:none;
    }

    .s24_player .icon-angle-up:before {
        content: "";
    }

    .s24_player .icon-angle-down:before {
        content: "";
    }

    .s24_player .bar.compact {
        top: -8px;
        padding:0px;
    }

    .is-player-expanded .s24_player .player{
        height:160px!important;
        z-index:10000;
    }

    .is-player-expanded .s24_player .player .player-controls {
        display:block;
    }


    .pod-det-data .s24_player .playerContainer.picInPic, .s24_player.playerContainer.picInPic {
        bottom:70px;
        
    }
    .is-player-expanded .pod-det-data .s24_player .playerContainer.picInPic, .is-player-expanded .playerContainer.picInPic {
        bottom:160px;
        width:90%;
        
    }

    .pod-det-data .s24_player .playerContainer.picInPic.maximized, .s24_player.playerContainer.picInPic.maximized{
        position:fixed;
        height:calc(100% - 70px);
        right:0px;
        width:100%;
        bottom: auto;
        top:0px;
        transform:none;
    }

    .is-player-expanded .pod-det-data .s24_player .playerContainer.picInPic.maximized, .is-player-expanded .s24_player.playerContainer.picInPic.maximized {
        height:calc(100% - 160px);
    }

    .s24_player.vpPlayer .bar-line--complete{
        position:relative;
        top:1px;
    }

    .s24_player .player-tools-btn .icon.icon-player-volume {
        font-size:24px;
        width:24px;
    }

    .is-fullscreen-in {
        overflow:hidden;
    }

    .is-fullscreen-in .s24_player .player-btn-wrapper {
        top:auto;
        bottom:19px;
    }

    .is-fullscreen-in .s24_player .bar {
        top:-22px;
    }

    .is-fullscreen-in .js-btn--player-expand {
        display:none!important;
    }
    .is-fullscreen-in .vpPlayer.s24_player .player {
        bottom:70px;
        height:120px!important;
    }

    .is-fullscreen-in .vpPlayer .player .playing {
        width:100%;
        padding-right:30px;
    }

    .is-fullscreen-in .vpPlayer .player .playing-title {
        white-space: auto;
    }

    .is-fullscreen-in .vpPlayer.s24_player .show-controls{
        display:block;
    }
    
    .is-fullscreen-in .vpPlayer.s24_player .controls{
        top:15px;
        right:15px;
        bottom: auto;
        left: auto;
    }

    .is-fullscreen-in .vpPlayer .player .playing-title{
        font-size:1.25rem;
        line-height:1.5rem;
        font-weight: 500;
    }

    .is-fullscreen-in .vpPlayer .backdrop, .is-fullscreen-in .mediaContainer .backdrop {
        z-index:200;
    }

    .is-fullscreen-in .vpPlayer .player .playing:after{
        content:"";
        background-image: -webkit-gradient(linear,left top, right top,color-stop(0, rgba(242,242,242,0)),to(rgba(29, 29, 29, 1)));
        background-image: linear-gradient(to right,rgba(242,242,242,0) 0,rgba(29, 29, 29, 1) 100%);
        background-repeat: repeat-x;
    }
    .is-fullscreen-in .vpPlayer .player-btn:hover {
        color:#fff;
        background: rgba(255,255,255,.1)
    }

    /* fullscreen per ios */
    .is-fullscreen-in-ios .vpPlayer .playerContainer{
        right: 50%;
        transform: translate(50%, 0);
        position: fixed;
    }
    .is-fullscreen-in-ios .vpPlayer .playerContainer video-js{
        z-index:200;

    }

    .is-fullscreen-in-ios .sticky-header {
        z-index:200;
    }
    .is-fullscreen-in-ios .main-header {
        position:static;
    }

}

@media (max-width: 767px) {
    .vpPlayer .playerContainer.picInPic, .s24_player.playerContainer.picInPic {
        width:90%;
        right:50%;
        transform: translate(50%, 0);
        bottom:70px;
    }
    
    .is-player-expanded .vpPlayer .playerContainer.picInPic, .is-player-expanded .s24_player.playerContainer.picInPic {
        bottom:160px;
    }
     

    .is-fullscreen-in .vpPlayer .playerContainer.picInPic, .is-fullscreen-in .s24_player.playerContainer.picInPic{
        width:100%;
        right:0;
        bottom:0;
        transform: translate(0, 0);
    }
}
    
