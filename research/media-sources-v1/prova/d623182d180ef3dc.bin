.visible {
  visibility: visible !important; }

.invisible {
  visibility: hidden !important; }

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0; }

.sr-only-focusable:active, .sr-only-focusable:focus {
  position: static;
  width: auto;
  height: auto;
  overflow: visible;
  clip: auto;
  white-space: normal; }

/*
  This mixin can be used to set the object-fit:
  @include object-fit(contain);

  or object-fit and object-position:
  @include object-fit(cover, top);
*/
.search-label, .search-toggle {
  font-size: 0.75rem; }
  @media (min-width: 360px) and (max-width: 767.98px) {
    .search-label, .search-toggle {
      font-size: 0.9375rem; } }
  @media (min-width: 1540px) {
    .search-label, .search-toggle {
      font-size: 0.8125rem; } }

.item-ord, .search-filter-title, .search-filter-link.search-filter-link--small {
  font-size: 0.875rem; }
  @media (min-width: 768px) {
    .item-ord, .search-filter-title, .search-filter-link.search-filter-link--small {
      font-size: 0.8125rem; } }
  @media (min-width: 1540px) {
    .item-ord, .search-filter-title, .search-filter-link.search-filter-link--small {
      font-size: 0.875rem; } }

.tab-pane-text, .search-filter-link, .search-filter-time, .link-icon {
  font-size: 0.8125rem; }
  @media (min-width: 360px) and (max-width: 767.98px) {
    .tab-pane-text, .search-filter-link, .search-filter-time, .link-icon {
      font-size: 0.9375rem; } }
  @media (min-width: 1024px) {
    .tab-pane-text, .search-filter-link, .search-filter-time, .link-icon {
      font-size: 0.9375rem; } }

.link-icon--big, .fullscreen-nav, .fullscreen-counter, .fullscreen-caption {
  font-size: 1rem; }
  @media (min-width: 768px) {
    .link-icon--big, .fullscreen-nav, .fullscreen-counter, .fullscreen-caption {
      font-size: 0.875rem; } }
  @media (min-width: 1540px) {
    .link-icon--big, .fullscreen-nav, .fullscreen-counter, .fullscreen-caption {
      font-size: 1rem; } }

.pod-sez {
  background: #212121;
  border-bottom: 40px solid #212121; }
  @media (min-width: 1540px) {
    .pod-sez {
      border-bottom: 50px solid #212121; } }
  .mb-0.pod-sez {
    border-bottom: none; }

.abox, .pod-det {
  background: #212121;
  border-bottom: 30px solid #212121; }

.abox--full {
  border-bottom: none !important; }

.list-sline-item:not(:first-child) {
  position: relative;
  padding-top: 10px; }
  .list-sline-item:not(:first-child)::before {
    content: '';
    display: block;
    width: 20px;
    border-top: 1px solid rgba(29, 29, 29, 0.3);
    position: absolute;
    top: 0;
    left: 0; }
    .inverted-color .list-sline-item:not(:first-child)::before {
      border-color: rgba(255, 255, 255, 0.3); }

.ltool:hover, a.hlink:hover, .link-icon--big:hover {
  color: #003c7f; }

.hcta, .hpage-title a, a.label, .btn--clr, .link-icon--clr, .modal-text a {
  color: #003c7f !important; }
  .hcta:hover, .hpage-title a:hover, a.label:hover, .btn--clr:hover, .link-icon--clr:hover, .modal-text a:hover {
    color: rgba(0, 60, 127, 0.7) !important; }

.btn--clr.btn--wine {
  color: #870042 !important; }
  .btn--clr.btn--wine:hover {
    color: rgba(135, 0, 66, 0.7) !important; }

.list-lined--dotted.list-lined--closed-top {
  background-image: -webkit-gradient(linear, left top, right top, from(rgba(29, 29, 29, 0.5)), color-stop(25%, rgba(29, 29, 29, 0.5)), color-stop(25%, rgba(29, 29, 29, 0)));
  background-image: linear-gradient(to right, rgba(29, 29, 29, 0.5) 0%, rgba(29, 29, 29, 0.5) 25%, rgba(29, 29, 29, 0) 25%);
  background-position: 0 top;
  background-size: 4px 1px;
  background-repeat: repeat-x; }

.list-lined--dotted .list-lined-item:not(:last-child), .list-lined--dotted.list-lined--closed .list-lined-item:last-child {
  background-image: -webkit-gradient(linear, left top, right top, from(rgba(29, 29, 29, 0.5)), color-stop(25%, rgba(29, 29, 29, 0.5)), color-stop(25%, rgba(29, 29, 29, 0)));
  background-image: linear-gradient(to right, rgba(29, 29, 29, 0.5) 0%, rgba(29, 29, 29, 0.5) 25%, rgba(29, 29, 29, 0) 25%);
  background-position: 0 bottom;
  background-size: 4px 1px;
  background-repeat: repeat-x; }

