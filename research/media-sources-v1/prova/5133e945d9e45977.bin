            <div wire:key="lw-4068824130-0" wire:snapshot="{&quot;data&quot;:[],&quot;memo&quot;:{&quot;id&quot;:&quot;bZvyYoVEKV99Hqu3j6TW&quot;,&quot;name&quot;:&quot;analytics.tracking&quot;,&quot;path&quot;:&quot;podcast\/i-podcast-della-rete-rurale-nazionale--5506797&quot;,&quot;method&quot;:&quot;GET&quot;,&quot;release&quot;:&quot;a-a-a&quot;,&quot;children&quot;:[],&quot;scripts&quot;:[],&quot;assets&quot;:[&quot;1320249421-0&quot;],&quot;errors&quot;:[],&quot;locale&quot;:&quot;en_US&quot;,&quot;islands&quot;:[]},&quot;checksum&quot;:&quot;11a8b5a934a7477bca77ae46a28058f7572a026521ec31745176a46ed8ab65df&quot;}" wire:effects="[]" wire:id="bZvyYoVEKV99Hqu3j6TW" wire:name="analytics.tracking"></div>
        
            <div x-persist="audio">
            <div wire:key="lw-4068824130-1" wire:snapshot="{&quot;data&quot;:[],&quot;memo&quot;:{&quot;id&quot;:&quot;9aOjGP2T1pbRXoBpTcE6&quot;,&quot;name&quot;:&quot;audio&quot;,&quot;path&quot;:&quot;podcast\/i-podcast-della-rete-rurale-nazionale--5506797&quot;,&quot;method&quot;:&quot;GET&quot;,&quot;release&quot;:&quot;a-a-a&quot;,&quot;children&quot;:[],&quot;scripts&quot;:[&quot;1421938729-0&quot;],&quot;assets&quot;:[],&quot;errors&quot;:[],&quot;locale&quot;:&quot;en_US&quot;,&quot;islands&quot;:[]},&quot;checksum&quot;:&quot;9f57fcd2d89a34831a7e2c3d9a8394a87689341609582c7a957100c21b23b998&quot;}" wire:effects="{&quot;scripts&quot;:{&quot;1421938729-0&quot;:&quot;    &lt;script&gt;\n        Alpine.data(&#039;audio&#039;, () =&gt; ({\n            \/**\n             * This method is used to get the on-demand playback url for a given url.\n             * This handles the presence of the playback token.\n             * Calling the ondemand endpoint guarantees that the consumption type of the listen is set to ondemand.\n             * When a valid playback token is present, the ondemand endpoint will have a way to identify the listener.\n             *\/\n            getOndemandOrDownloadUrl(url) {\n                return SP.Utils.getOndemandOrDownloadUrl(url);\n            },\n            \/**\n             * This method is used to persist alpine store data in the local storage scoped to the user.\n             *\/\n            persist(val, key) {\n                const userId = null || &#039;guest&#039;;\n                return Alpine.$persist(val).as(SP.Utils.getLocalStorageKey(userId, key));\n            },\n            \/**\n             * This method is used to fetch and store the variant of a given playback url.\n             * To detrmine the variant, we need to make a HEAD request to the playback url because we need to follow\n             * the redirect to the actual audio file. At this point if the url contains the variant, we can extract it\n             *\/\n            fetchVariant(src) {\n                return fetch(src, {\n                    method: &#039;HEAD&#039;\n                }).then((response) =&gt; {\n                    Alpine.store(&#039;audio&#039;).variant = SP.Utils.extractVariant(response.url);\n                }).catch(() =&gt; {\n                    Alpine.store(&#039;audio&#039;).variant = null;\n                });\n            },\n            init() {\n                const $audioRef = this.$refs.audio;\n                const getOndemandOrDownloadUrl = this.getOndemandOrDownloadUrl;\n\n                Alpine.store(&#039;audio&#039;, {\n                    \/\/ Persisted on local storage\n                    episodeQueue: this.persist([], &#039;audio.episode_queue&#039;),\n                    activeEpisode: this.persist(null, &#039;audio.active_episode&#039;),\n                    playback_token: this.persist(null, &#039;audio.playback_token&#039;),\n                    episodesProgress: this.persist({}, &#039;audio.episodes_progress&#039;),\n                    episodesDuration: this.persist({}, &#039;audio.episodes_duration&#039;),\n                    episodesCurrent: this.persist({}, &#039;audio.episodes_current&#039;),\n                    episodesCompleted: this.persist({}, &#039;audio.episodes_completed&#039;),\n                    \/\/ Not persisted on local storage\n                    playbackRate: 1,\n                    playing: false,\n                    loading: false,\n                    variant: null,\n\n                    \/**\n                     * PUBLIC METHODS\n                     *\/\n\n                    play() {\n                        if (this.playing) {\n                            return;\n                        }\n                        if (this.activeEpisode) {\n                            this._updateAudioSrc(this.activeEpisode);\n                            this._updateMediaSession(this.activeEpisode);\n                            this._trackAmplitudeEvent(&#039;played&#039;, this.activeEpisode);\n                            this._trackBackendPlaybackEvent(&#039;play&#039;, this.activeEpisode, this\n                                .getCurrent());\n                            this.changePlaybackRate(this.playbackRate);\n                            $audioRef.currentTime = this.getCurrent();\n                            $audioRef.play();\n                            return;\n                        } else if (this.episodeQueue.length === 0) {\n                            return;\n                        } else {\n                            this.activeEpisode = this.episodeQueue[0];\n                            this._dequeue(this.activeEpisode);\n                            this._updateAudioSrc(this.activeEpisode);\n                            this._updateMediaSession(this.activeEpisode);\n                            this._trackAmplitudeEvent(&#039;played&#039;, this.activeEpisode);\n                            this._trackBackendPlaybackEvent(&#039;play&#039;, this.activeEpisode, this\n                                .getCurrent());\n                            this.changePlaybackRate(this.playbackRate);\n\n                            \/\/ If the episode was completed we start from the beginning\n                            \/\/ and mark it as not completed, so that we can track the progress\n                            \/\/ locally and the user can resume from where they left off\n                            if (this.getCompleted()) {\n                                this.resetProgress();\n                            }\n\n                            $audioRef.currentTime = this.getCurrent();\n                            $audioRef.play();\n                        }\n                    },\n                    pause() {\n                        this._trackAmplitudeEvent(&#039;paused&#039;, this.activeEpisode);\n                        this._trackBackendPlaybackEvent(&#039;pause&#039;, this.activeEpisode, this.getCurrent());\n                        $audioRef.pause();\n                    },\n                    plus30() {\n                        if (!this.activeEpisode) {\n                            return;\n                        }\n                        this.setCurrentTime(this.getCurrent() + 30);\n                        this._trackAmplitudeEvent(&#039;seek_forward&#039;, this.activeEpisode);\n                        this._trackBackendPlaybackEvent(&#039;seek&#039;, this.activeEpisode, this.getCurrent());\n                    },\n                    minus10() {\n                        if (!this.activeEpisode) {\n                            return;\n                        }\n                        this.setCurrentTime(this.getCurrent() - 10);\n                        this._trackAmplitudeEvent(&#039;seek_backward&#039;, this.activeEpisode);\n                        this._trackBackendPlaybackEvent(&#039;seek&#039;, this.activeEpisode, this.getCurrent());\n                    },\n                    seek(progress) {\n                        if (!this.activeEpisode) {\n                            return;\n                        }\n                        const duration = $audioRef.duration || this.activeEpisode.duration \/ 1000;\n                        const current = duration * progress;\n                        this.setCurrentTime(current);\n                        this._trackAmplitudeEvent(&#039;seek_at&#039;, this.activeEpisode);\n                        this._trackBackendPlaybackEvent(&#039;seek&#039;, this.activeEpisode, this.getCurrent());\n                        this.play();\n                    },\n                    changePlaybackRate(rate) {\n                        this.playbackRate = rate;\n                        $audioRef.playbackRate = rate;\n                    },\n                    next(automatic = false) {\n                        this._trackAmplitudeEvent(&#039;next&#039;, this.activeEpisode, {\n                            automatic\n                        });\n                        if (automatic) {\n                            this.setProgress(0);\n                            this.setDuration(null);\n                            this.setCurrent(0);\n                        }\n                        this._stop();\n                        this.play();\n                    },\n                    playNow(episode) {\n                        if (this._equals(this.activeEpisode, episode)) {\n                            this.play();\n                            return;\n                        }\n                        this._stop();\n                        this._enqueueHead(episode);\n                        this.play();\n                        this._emitEpisodePlayEvent();\n                    },\n                    playPause(episode) {\n                        if (this._equals(this.activeEpisode, episode) &amp;&amp; !this.loading) {\n                            if (this.playing) {\n                                this.pause();\n                            } else {\n                                this.play();\n                            }\n                        } else {\n                            this.playNow(episode);\n                        }\n                    },\n                    isEpisodePlaying(episode) {\n                        return this._equals(this.activeEpisode, episode) &amp;&amp; this.playing;\n                    },\n                    shouldDisplayLoading(episode) {\n                        return this._equals(this.activeEpisode, episode) &amp;&amp; this.loading;\n                    },\n                    shouldDisplayPlay(episode) {\n                        return (\n                            (!this._equals(this.activeEpisode, episode)) ||\n                            (this._equals(this.activeEpisode, episode) &amp;&amp; !this.playing &amp;&amp; !this\n                                .loading)\n                        );\n                    },\n                    shouldDisplayPause(episode) {\n                        return this._equals(this.activeEpisode, episode) &amp;&amp; this.playing &amp;&amp; !this\n                            .loading;\n                    },\n                    isEpisodeActiveOrQueued(episode) {\n                        return this._isEpisodeActive(episode) || this.episodeQueue.some((\n                            queuedEpisode) =&gt; {\n                            return this._equals(queuedEpisode, episode);\n                        });\n                    },\n                    countLoadedEpisodes() {\n                        return this.episodeQueue.length + (this.activeEpisode ? 1 : 0);\n                    },\n                    addToQueue(episode) {\n                        if (this._equals(this.activeEpisode, episode)) {\n                            return;\n                        }\n                        this._dequeue(episode);\n                        this.episodeQueue = [...this.episodeQueue, episode];\n                        if (this.episodeQueue.length === 1 &amp;&amp; !this.activeEpisode) {\n                            this.activeEpisode = this.episodeQueue[0];\n                            this._dequeue(this.activeEpisode);\n                        }\n                        this._trackAmplitudeEvent(&#039;queue_added&#039;, episode, {\n                            queue_length: this.countLoadedEpisodes()\n                        });\n                    },\n                    removeFromQueue(episode) {\n                        this._dequeue(episode);\n                        this._trackAmplitudeEvent(&#039;queue_removed&#039;, episode, {\n                            queue_length: this.countLoadedEpisodes()\n                        });\n                    },\n                    moveUpInQueue(episode) {\n                        const index = this.episodeQueue.findIndex((queuedEpisode) =&gt; {\n                            return this._equals(queuedEpisode, episode);\n                        });\n                        if (index === 0) {\n                            return;\n                        }\n                        const prev = this.episodeQueue[index - 1];\n                        this.episodeQueue[index - 1] = episode;\n                        this.episodeQueue[index] = prev;\n                    },\n                    moveDownInQueue(episode) {\n                        const index = this.episodeQueue.findIndex((queuedEpisode) =&gt; {\n                            return this._equals(queuedEpisode, episode);\n                        });\n                        if (index === this.episodeQueue.length - 1) {\n                            return;\n                        }\n                        const next = this.episodeQueue[index + 1];\n                        this.episodeQueue[index + 1] = episode;\n                        this.episodeQueue[index] = next;\n                    },\n                    setCurrentTime(time) {\n                        if (isNaN(time)) {\n                            return;\n                        }\n\n                        \/\/ Ensure the time is within the bounds of the audio\n                        time = Math.min(Math.max(0, time), $audioRef.duration || this.activeEpisode\n                            .duration \/ 1000);\n\n                        this.setCurrent(time);\n                        $audioRef.currentTime = time;\n                    },\n                    getProgress() {\n                        if (!this.activeEpisode) {\n                            return 0;\n                        }\n                        return this.episodesProgress[this.activeEpisode.episode_id];\n                    },\n                    getEpisodeProgress(episode) {\n                        return this.episodesProgress[episode.episode_id] || 0;\n                    },\n                    getEpisodeCurrent(episode) {\n                        return this.episodesCurrent[episode.episode_id] || 0;\n                    },\n                    getEpisodeDuration(episode) {\n                        return this.episodesDuration[episode.episode_id] || episode.duration \/ 1000;\n                    },\n                    getEpisodeCompleted(episode) {\n                        return this.episodesCompleted[episode.episode_id] || false;\n                    },\n                    getEpisodeMinLeft(episode) {\n                        const current = this.getEpisodeCurrent(episode);\n                        const duration = this.getEpisodeDuration(episode);\n                        return SP.Utils.formatTimeLeft(duration - current, SP.Viewer.language);\n                    },\n                    setProgress(progress) {\n                        if (!this.activeEpisode) {\n                            return;\n                        }\n                        this.episodesProgress[this.activeEpisode.episode_id] = progress;\n                    },\n                    getDuration() {\n                        if (!this.activeEpisode) {\n                            return null;\n                        }\n                        return this.episodesDuration[this.activeEpisode.episode_id] || this\n                            .activeEpisode.duration \/ 1000;\n                    },\n                    setDuration(duration) {\n                        if (!this.activeEpisode) {\n                            return;\n                        }\n                        this.episodesDuration[this.activeEpisode.episode_id] = duration;\n                    },\n                    getCurrent() {\n                        if (!this.activeEpisode) {\n                            return 0;\n                        }\n                        return this.episodesCurrent[this.activeEpisode.episode_id] || 0;\n                    },\n\n                    setCurrent(current) {\n                        if (!this.activeEpisode) {\n                            return;\n                        }\n                        this.episodesCurrent[this.activeEpisode.episode_id] = current;\n                    },\n                    getCompleted() {\n                        if (!this.activeEpisode) {\n                            return false;\n                        }\n                        return this.episodesCompleted[this.activeEpisode.episode_id] || false;\n                    },\n                    setCompleted(completed) {\n                        if (!this.activeEpisode) {\n                            return;\n                        }\n                        this.episodesCompleted[this.activeEpisode.episode_id] = completed;\n                    },\n                    updateEpisode(episode) {\n                        \/\/ We update the active episode\n                        if (this._isEpisodeActive(episode)) {\n                            this.activeEpisode = episode;\n                        }\n                        \/\/ We update episode in the queue\n                        this.episodeQueue = this.episodeQueue.map((queuedEpisode) =&gt; {\n                            if (this._equals(queuedEpisode, episode)) {\n                                return episode;\n                            }\n                            return queuedEpisode;\n                        });\n                        \/\/ We update the progress, duration and current time for the non active episodes\n                        if (!this._isEpisodeActive(episode) &amp;&amp; episode.progress) {\n                            const newProgress = (episode.progress \/ episode.duration) * 100\n                            const newDuration = episode.duration \/ 1000;\n                            const newCurrent = episode.progress \/ 1000;\n                            const newCompleted = !!episode.completed_at;\n\n                            this.episodesProgress[episode.episode_id] = newProgress;\n                            this.episodesDuration[episode.episode_id] = newDuration;\n                            this.episodesCurrent[episode.episode_id] = newCurrent;\n                            this.episodesCompleted[episode.episode_id] = newCompleted;\n                        }\n                    },\n                    getEpisodePlayButtonState(episode) {\n                        if (this.shouldDisplayLoading(episode)) {\n                            return &#039;LOADING&#039;;\n                        }\n\n                        if (this.shouldDisplayPause(episode)) {\n                            return &#039;PAUSE&#039;;\n                        }\n\n                        if (\n                            this.shouldDisplayPlay(episode) &amp;&amp;\n                            this.getEpisodeCompleted(episode) ||\n                            !this.getEpisodeCurrent(episode)\n                        ) {\n                            return &#039;PLAY&#039;;\n                        }\n\n                        return &#039;RESUME&#039;;\n                    },\n                    displayEpisodeProgress(episode) {\n                        if (this.isEpisodePlaying(episode)) {\n                            return true;\n                        }\n                        if (!this.getEpisodeCompleted(episode) &amp;&amp; this.getEpisodeCurrent(episode)) {\n                            return true;\n                        }\n                        return false;\n                    },\n                    displayEpisodeDuration(episode) {\n                        if (this.isEpisodePlaying(episode)) {\n                            return false;\n                        }\n\n                        if (!this.getEpisodeCompleted(episode) &amp;&amp; this.getEpisodeCurrent(episode)) {\n                            return false;\n                        }\n\n                        return true;\n                    },\n                    resetProgress() {\n                        this.setProgress(0);\n                        this.setCompleted(false);\n                    },\n\n                    \/**\n                     * PRIVATE METHODS\n                     *\/\n\n                    \/**\n                     * The media session API is used to display the current episode information on the lock screen\n                     * of the device. The current implementations are pretty limited and buggy so conside this as\n                     * a best effort.\n                     *\/\n                    _updateMediaSession(episode) {\n                        if (&#039;mediaSession&#039; in navigator) {\n                            const metadata = {\n                                title: episode.title,\n                                artist: episode.show.title,\n                                artwork: [{\n                                        src: SP.Utils.getNuvolariImageUrl(\n                                            episode.image_original_url,\n                                            &#039;square_limited_160&#039;,\n                                        ),\n                                        sizes: &#039;160x160&#039;,\n                                        type: &#039;image\/jpeg&#039;,\n                                    },\n                                    {\n                                        src: SP.Utils.getNuvolariImageUrl(\n                                            episode.image_original_url,\n                                            &#039;square_limited_480&#039;,\n                                        ),\n                                        sizes: &#039;480x480&#039;,\n                                        type: &#039;image\/jpeg&#039;,\n                                    },\n                                    {\n                                        src: SP.Utils.getNuvolariImageUrl(\n                                            episode.image_original_url,\n                                            &#039;square_limited_720&#039;,\n                                        ),\n                                        sizes: &#039;720x720&#039;,\n                                        type: &#039;image\/jpeg&#039;,\n                                    },\n                                ],\n                            };\n                            navigator.mediaSession.metadata = new MediaMetadata(\n                                metadata,\n                            );\n\n                            navigator.mediaSession.setActionHandler(\n                                &#039;seekbackward&#039;, () =&gt; {\n                                    this.minus10();\n                                });\n                            navigator.mediaSession.setActionHandler(\n                                &#039;seekforward&#039;, () =&gt; {\n                                    this.plus30();\n                                });\n\n                            navigator.mediaSession.setActionHandler(\n                                &#039;nexttrack&#039;, () =&gt; {\n                                    this.next();\n                                });\n\n                            navigator.mediaSession.setActionHandler(\n                                &#039;play&#039;, () =&gt; {\n                                    this.play();\n                                });\n\n                            navigator.mediaSession.setActionHandler(\n                                &#039;pause&#039;, () =&gt; {\n                                    this.pause();\n                                });\n                        }\n                    },\n                    _emitEpisodePlayEvent() {\n                        window.dispatchEvent(new CustomEvent(&#039;episode-play&#039;));\n                    },\n                    _updateAudioSrc: (episode) =&gt; {\n                        const newSrc = getOndemandOrDownloadUrl(episode?.playback_url);\n                        if ($audioRef.src !== newSrc) {\n                            $audioRef.src = newSrc;\n                        }\n                    },\n                    _trackAmplitudeEvent(action, episode, data = {}) {\n                        if (episode) {\n                            SP.Amplitude.sendEvent(`player_${action}`, {\n                                podcast_title: episode.show?.title,\n                                podcast_id: episode.show?.show_id,\n                                episode_id: episode.episode_id,\n                                episode_title: episode.title,\n                                ...data,\n                            });\n                        }\n                    },\n                    _trackBackendPlaybackEvent(action, episode, current) {\n                        \/\/ If the user is not authenticated we do nothing\n                    },\n                    _equals(episode, other) {\n                        if (episode === null || other === null) {\n                            return false;\n                        }\n                        return episode.episode_id === other.episode_id;\n                    },\n                    _isEpisodeActive(episode) {\n                        return this._equals(this.activeEpisode, episode);\n                    },\n                    _enqueueHead(episode) {\n                        this._dequeue(episode);\n                        this.episodeQueue = [episode, ...this.episodeQueue];\n                    },\n                    _dequeue(episode) {\n                        this.episodeQueue = this.episodeQueue.filter((queuedEpisode) =&gt; {\n                            return !this._equals(queuedEpisode, episode);\n                        });\n                    },\n                    _update() {\n                        this.playing = !$audioRef.paused;\n                        this.loading = $audioRef.readyState &lt; 4;\n                        if ($audioRef.duration) {\n                            this.setProgress($audioRef.currentTime \/ $audioRef.duration * 100);\n                            this.setDuration($audioRef.duration);\n                            this.setCurrent($audioRef.currentTime);\n                        }\n                    },\n                    _reset() {\n                        this.playing = false;\n                        this.loading = false;\n                        this.variant = null;\n                    },\n                    _ended() {\n                        this.loading = false;\n                        this.setCompleted(true);\n                        this.next(true);\n                    },\n                    _stop() {\n                        if (!this.activeEpisode) {\n                            return;\n                        }\n                        this._dequeue(this.activeEpisode);\n                        this.activeEpisode = null;\n                        $audioRef.currentTime = 0;\n                        $audioRef.src = &#039;&#039;;\n                        this._reset();\n                    }\n                });\n\n                const update = () =&gt; {\n                    Alpine.store(&#039;audio&#039;)._update();\n                };\n\n                const loadedmetadata = () =&gt; {\n                    this.fetchVariant($audioRef.src);\n                };\n\n                const ended = () =&gt; {\n                    Alpine.store(&#039;audio&#039;)._ended();\n                };\n\n                $audioRef.addEventListener(&#039;play&#039;, update);\n                $audioRef.addEventListener(&#039;pause&#039;, update);\n                $audioRef.addEventListener(&#039;loadedmetadata&#039;, loadedmetadata);\n                $audioRef.addEventListener(&#039;timeupdate&#039;, update);\n                $audioRef.addEventListener(&#039;ended&#039;, ended);\n                $audioRef.addEventListener(&#039;error&#039;, ended);\n            }\n        }));\n\n        Alpine.data(&#039;audio_token&#039;, () =&gt; ({\n            playbackTokenInterval: null,\n            playbackProgressInterval: null,\n            \/**\n             * This method is used to fetch a playback token from the backend and store it in the alpine store.\n             * The playback token is stored in the alpine store so that it can be used to generate the on-demand\n             * playback url.\n             *\n             * We need to call it withCredentials since the cookie is the only way for the app to identify the user.\n             *\/\n            fetchAndStorePlaybackToken() {\n                return fetch(&#039;\/playback\/token&#039;, {\n                    method: \&quot;POST\&quot;,\n                    withCredentials: true,\n                    headers: {\n                        &#039;Content-Type&#039;: &#039;application\/json&#039;,\n                        &#039;Accept&#039;: &#039;application\/json&#039;,\n                        &#039;X-Csrf-Token&#039;: window.livewireScriptConfig.csrf\n                    },\n                }).then((r) =&gt; {\n                    if (r.status !== 200) {\n                        return null;\n                    }\n                    return r.json();\n                }).then((r) =&gt; {\n                    Alpine.store(&#039;audio&#039;).playback_token = r || null;\n                }).catch((e) =&gt; {\n                    Alpine.store(&#039;audio&#039;).playback_token = null;\n                })\n            },\n            \/**\n             * This method runs once when the page is loaded, so here we&#039;re calling\n             * ensurePlaybackToken to fetch a playback token if there isn&#039;t any.\n             * The playback token TTL is 6 hours, so we set an interval to check the\n             * expiration of the playback token every 30 minutes. The token will be\n             * refreshed if the token is to be expired in 1 hour or less, so this way\n             * the user can&#039;t be without a token.\n             *\/\n            ensurePlaybackToken() {\n                const ONE_HOUR = 60 * 60 * 1000;\n                const currentToken = Alpine.store(&#039;audio&#039;).playback_token;\n\n                if (currentToken) {\n                    const expirationDate = new Date(`${currentToken.expires_at} UTC`);\n                    const now = new Date();\n                    const diff = (expirationDate - now);\n                    if (diff &gt; ONE_HOUR) {\n                        return;\n                    }\n                }\n\n                return this.fetchAndStorePlaybackToken();\n            },\n            init() {\n                const FIFTEEN_MINUTES = 15 * 60 * 1000;\n                const THIRTY_SECONDS = 30 * 1000;\n\n                this.ensurePlaybackToken();\n                this.playbackTokenInterval = setInterval(() =&gt; {\n                    this.ensurePlaybackToken();\n                }, FIFTEEN_MINUTES);\n\n                this.playbackProgressInterval = setInterval(() =&gt; {\n                    this._trackBackendPlaybackProgress();\n                }, THIRTY_SECONDS);\n\n                Alpine.store(&#039;audio&#039;)._trackBackendPlaybackEvent = this._trackBackendPlaybackEvent;\n            },\n            destroy() {\n                clearInterval(this.playbackTokenInterval);\n                clearInterval(this.playbackProgressInterval);\n            },\n\n            \/**\n             * PRIVATE METHODS\n             *\/\n\n            _trackBackendPlaybackEvent(action, episode, current) {\n                if (!episode || isNaN(current)) {\n                    return;\n                }\n\n                if (current &lt; 0) {\n                    return;\n                }\n\n                fetch(`\/playback\/${episode.episode_id}\/events`, {\n                    method: \&quot;POST\&quot;,\n                    withCredentials: true,\n                    headers: {\n                        &#039;Content-Type&#039;: &#039;application\/json&#039;,\n                        &#039;Accept&#039;: &#039;application\/json&#039;,\n                        &#039;X-Csrf-Token&#039;: window.livewireScriptConfig.csrf\n                    },\n                    body: JSON.stringify({\n                        event_type: action,\n                        progress: Math.floor(current * 1000),\n                    })\n                }).catch(() =&gt; {})\n            },\n\n            _trackBackendPlaybackProgress() {\n                let audioStore = Alpine.store(&#039;audio&#039;);\n                if (!audioStore.playing) {\n                    return;\n                }\n\n                this._trackBackendPlaybackEvent(&#039;progress&#039;, audioStore.activeEpisode, audioStore\n                    .getCurrent());\n            }\n        }));\n    &lt;\/script&gt;\n    &quot;}}" wire:id="9aOjGP2T1pbRXoBpTcE6" wire:name="audio" x-data="audio">
