                        <div
                id="main-content"
                class="md:pl-[250px] md:fixed md:bottom-16 md:top-16 pt-16 h-full md:h-auto pb-32 w-full overflow-y-auto bg-neutral-100 dark:bg-neutral-950 md:pb-0 md:pt-0">
                <div
    x-data="{
        toast: null,
        toastTimeout: null,
        showToast(toast) {
            this.removeToast();
            this.toast = toast;
            this.autoRemoveToast();
        },
        removeToast() {
            if (this.toastTimeout) {
                clearTimeout(this.toastTimeout);
            }
            this.toast = null;
        },
        autoRemoveToast() {
            if (!this.toast) {
                return;
            }
            let timings = {
                default: 5000, // 5 seconds
                info: 5000, // 5 seconds
                success: 5000, // 5 seconds
                error: 10000, // 10 seconds
                warning: 10000 // 10 seconds
            }
            this.toastTimeout = setTimeout(() => {
                if (this.toast) {
                    this.toast = null;
                }
            }, timings[this.toast.type]);
        },
        getClassType() {
            return {
                'bg-neutral-700 dark:bg-neutral-100 text-white dark:text-neutral-950': this
                    .toast?.type === 'default',
                'bg-sky-700 text-white': this.toast?.type === 'info',
                'bg-emerald-700 text-white': this.toast?.type === 'success',
                'bg-red-800 text-white': this.toast?.type === 'error',
                'bg-orange-400 text-neutral-950': this.toast?.type === 'warning'
            }
        }
    }" x-on:toast.window="showToast($event.detail)" x-show="toast" class="fixed left-0 right-0 z-10 md:left-[250px]"
    x-transition>
    <div
    x-bind:class="getClassType" class="m-2 flex items-center justify-between gap-3 rounded-md px-4 py-2 text-sm font-semibold">
    <svg class="shrink-0" x-show="toast?.type === &#039;default&#039;" data-icon-type="outline" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
    xmlns="http://www.w3.org/2000/svg" stroke="none">
    <path fill-rule="evenodd" clip-rule="evenodd"
