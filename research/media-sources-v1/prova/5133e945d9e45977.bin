    <script>
        window.SP = window.SP || {};
        window.SP.Viewer = {
            country: "IT",
            language: "en",
            culture: "en_US",
        };
    </script>
    
    <script>
        window.amplitudeSettings = {
            'api_key': '10aa248c285498f5ee621903488bb9dc',
            'user_id': null,
            'experiments': [],
        };

        window.Sp = window.Sp || {};
        window.Sp.util = window.Sp.util || {};
        window.Sp.util.Amplitude = Sp.util.Amplitude || {

            _whenLoaded: [],

            init: function() {

                if (!window.amplitudeSettings || typeof amplitude === "undefined") {
                    return;
                }

                amplitude.getInstance().init(
                    window.amplitudeSettings.api_key,
                    window.amplitudeSettings.user_id, {
                        includeUtm: true,
                        includeReferrer: true,
                        saveParamsReferrerOncePerSession: false,
                        unsetParamsReferrerOnNewSession: true,
                        domain: document.domain,
                        secureCookie: true,
                    },
                    () => {
                        // Track the Google Ads click id, when present, as a user property (requires OneTrust C0004 consent)
                        const gclid = new URLSearchParams(window.location.search).get('gclid');
                        const onetrustActiveGroups = window.OnetrustActiveGroups || '';
                        if (
                            gclid && onetrustActiveGroups && onetrustActiveGroups.split(',').includes('C0004')
                        ) {
                            Sp.util.Amplitude.setUserProperty('gclid', gclid);
                        }

                        // Consume pending event queues and swap with a syncronous executor
                        Sp.util.Amplitude._whenLoaded.forEach((fn) => {
                            fn.apply();
                        });
                        Sp.util.Amplitude._whenLoaded.push = (fn) => {
                            fn.apply();
                        }
                    }
                );
            },

            /**
             * Sends an event to Amplitude
             *
             * @param {String} eventName
             * @param {String} eventProperties  JSON enconded object
             */
            sendEvent: function(eventName, eventProperties) {
                Sp.util.Amplitude._whenLoaded.push(() => {

                    if (typeof eventProperties === "string") {
                        eventProperties = JSON.parse(eventProperties);
                    }

                    eventProperties = Object.assign(eventProperties, {
                        'application': eventProperties.application || 'Spreaker NEXT',
                        'experiments': window.amplitudeSettings.experiments,
                    });

                    amplitude.getInstance().logEvent(eventName, eventProperties);
                });
            },

            /**
             * Sets a user property in Amplitude
             *
             * @param {String} propertyName
             * @param {String} propertyValue
             */
            setUserProperty: function(propertyName, propertyValue) {
                Sp.util.Amplitude._whenLoaded.push(() => {
                    var identify = new amplitude.Identify().set(propertyName, propertyValue);
                    amplitude.getInstance().identify(identify);
                });
            }
        };

        (function(w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({
                'gtm.start': new Date().getTime(),
                event: 'gtm.js'
            });
            var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src =
                'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-PMD8LDV');
    </script>
    

