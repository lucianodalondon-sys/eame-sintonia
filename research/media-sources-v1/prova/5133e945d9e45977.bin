</svg>
        <svg class="shrink-0" x-show="toast?.type === &#039;info&#039;" data-icon-type="outline" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
    xmlns="http://www.w3.org/2000/svg" stroke="none">
    <path fill-rule="evenodd" clip-rule="evenodd"
