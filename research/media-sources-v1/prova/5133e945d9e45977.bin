    <script>
        window.SP = window.SP || {};
        window.SP.MetaTheme = {
            changed(dark) {
                const meta = document.querySelector('meta[name="theme-color"]');
                if (dark) {
                    meta.setAttribute('content', '#262626');
                } else {
                    meta.setAttribute('content', '#ffffff');
                }
            }
        };
        window.SP.MetaTheme.changed(localStorage.getItem('sp_storage.theme.dark') === 'true');
    </script>

    
    <script>
        document.ondblclick = function(e) {
            e.preventDefault();
        }
    </script>

    
    <div x-persist="ot-container">
        <div id="onetrust-pc-container"></div>
    </div>
    <script data-navigate-once>
        document.addEventListener('livewire:initialized', () => {
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.addedNodes.length) {
                        // Look for the OneTrust preference center container
                        const otContainer = Array.from(mutation.addedNodes).find(node =>
                            node.nodeType === 1 && node.id === 'onetrust-consent-sdk');

                        if (otContainer) {
                            document.getElementById('onetrust-pc-container').appendChild(
                                otContainer);
                            observer.disconnect();
                        }
                    }
                });
            });
            observer.observe(document.body, {
                childList: true
            });
        })
    </script>

