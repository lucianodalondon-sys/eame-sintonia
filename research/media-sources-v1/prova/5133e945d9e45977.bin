    <div x-persist="signup_cta">
        <div
            x-data="{
                silence_for: 1000 * 60 * 60 * 24,
                state: {
                    open: false
                },
                last_opened_at: $persist(null).as('sp_storage.modals.signup_cta_last_opened_at'),
                play_count: $persist(0).as('sp_storage.modals.signup_cta_play_count'),
                updateOpen() {
                    if (this.play_count <= 2) {
                        this.state.open = false;
                        return;
                    }
                    if (this.last_opened_at && Date.now() - this.last_opened_at < this.silence_for) {
                        this.state.open = false;
                        return;
                    }
                    this.state.open = true;
                },
                onEpisodePlay() {
                    this.play_count += 1;
                    this.updateOpen();
                },
                updateOpened() {
                    this.last_opened_at = Date.now();
                    this.play_count = 0;
                }
            }"
            x-on:episode-play.window="onEpisodePlay()">
            <div
    x-data="{ 'state.open': state.open }"
    x-init="$watch('state.open', (opened) => {
        SP.Utils.setDocumentShouldScroll(!opened);
    })">
        <template x-teleport="body">
        <div
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-out duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            x-show="state.open"
            aria-labelledby="modal-title"
            role="dialog"
            aria-modal="true"
            class="relative z-40">
            <div
                class="fixed inset-0 bg-neutral-500 bg-opacity-85 transition-opacity dark:bg-neutral-700 dark:bg-opacity-85">
            </div>
            <div class="fixed inset-0 z-40 w-screen overflow-y-auto"
                x-show="state.open"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="translate-y-32"
                x-transition:enter-end="translate-y-0"
                x-transition:leave="transition ease-out duration-200"
                x-transition:leave-start="translate-y-0"
                x-transition:leave-end="translate-y-32">
                <div class="flex items-end justify-center p-4 sm:items-center sm:p-0">
                                            <div x-on:click.away="state.open = false" class="rounded-2xl bg-white dark:bg-neutral-800 p-4 flex flex-col drop-shadow-lg my-6 w-11/12 max-w-2xl relative z-40">
        <div class="flex flex-row justify-between text-center sm:text-left">
    <div class="flex-1">
