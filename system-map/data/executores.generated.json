  },
  "CANONICAL_FORWARD_PATH": {
   "CANONICAL_FORWARD_PATH_PROVED": "YES",
   "O_QUE_MEDE": "se algum executor tem a sua ESTRADA CANONICA FORWARD instrumentada — raw_asset real no banco, dono canonico da escrita, e a passagem a chegar ao rastro — e nao apenas um replay do corpo historico.",
   "A_LEI": "LEGACY_REPLAY_INSTRUMENTED != CANONICAL_FORWARD_INSTRUMENTED",
