<section class="portlet" id="portlet_com_liferay_asset_publisher_web_portlet_AssetPublisherPortlet_INSTANCE_xaV5V5LZils2">


	<div class="portlet-content">

			<div class="autofit-float autofit-row portlet-header">



								
							<div class="autofit-col autofit-col-expand">
							
							
									
									
