<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".nav-item-arpac-level1").forEach(function (item) {
        const link = item.querySelector("a");
        if (link && link.textContent.trim().toLowerCase() === "contatti") {
            // Aggiungi classe al menu padre
            item.classList.add("nav-contatti");

            // Crea stile dinamico
            const style = document.createElement("style");
            style.innerHTML = `
                .nav-contatti .dropdown-menu .row {
                    display: flex !important;
                    justify-content: flex-end !important;
                }
            `;
            document.head.appendChild(style);
        }
    });
});
</script>


<script>
function applyBlankTarget() {
    var pathParts = window.location.pathname.replace(/\/$/, "").split("/");
   //  console.log("=== applyBlankTarget chiamata ===");
   //  console.log("pathname:", window.location.pathname);
  //  console.log("pathParts.length:", pathParts.length);
    
    var link = document.querySelector('a[href="https://arpacampania.portaletrasparenza.net/"]');
   // console.log("link trovato:", link);
    
    if (link) {
        link.setAttribute("target", "_blank");
        link.setAttribute("rel", "noopener noreferrer");
     //   console.log("target _blank applicato!");
    }
}

// Prima visita
document.addEventListener("DOMContentLoaded", applyBlankTarget);

// Prova tutti gli eventi Liferay di navigazione
Liferay.on('endNavigate', function() { console.log("endNavigate fired"); applyBlankTarget(); });
Liferay.on('startNavigate', function() { console.log("startNavigate fired"); });
Liferay.on('beforeNavigate', function() { console.log("beforeNavigate fired"); });
</script>
			
