<script>



jQuery( document ).ready(function() {

	jQuery.getJSON("https://allertaliguria.regione.liguria.it/outputxml.php",function(result){
		//if(result.color!="VERDE") {
				//console.log(result)
			jQuery("#ticketallerta").html(
				"<div class=xmlicone>" +
				"<a href='https://allertaliguria.regione.liguria.it'><img loading='lazy' alt='Vai al Sito della Protezione Civile' src='http://www.regione.liguria.it/images/ico_protezionecivile.png'></a>"+
				"<img loading='lazy' class='w-100' src='/images/mappeAllerta/"+ result.mappa+ "' alt='"+result.allertaText+"' class='icoallerta'>"+
				"</div>" +
				"<strong><div class=xmldataemissione>Data emissione " +

				 result.dataEmissione.slice(8,10) + ":" + result.dataEmissione.slice(10,12) + " del  " + result.dataEmissione.slice(6,8) + "/" + result.dataEmissione.slice(4,6) + "/" + result.dataEmissione.slice(0,4) + "</div> <div class=xmllivello>LIVELLO DI ALLERTA " + result.color + "</div>" +
				"</strong> " +
				"<div class=xmlallertatext>" + result.allertaText + "</div>" );
			jQuery("#ticketallerta").show();
		//}
	});


	jQuery( ".ecl-accordion2__toggle" ).each(function( index ) {
		jQuery(this).attr("aria-expanded", "false");
	});

	jQuery(".ecl-accordion2__toggle").click(function() {

		jQuery( ".ecl-accordion2__toggle" ).not(this).each(function( index ) {
			jQuery(this).attr("aria-expanded", "false");
			jQuery(this).find(".ecl-accordion2__toggle-icon").html('<svg viewBox="0 0 25 25"><use xlink:href="/static/media/icons.3cf410f9.svg#ui--plus"></use></svg>');
		});


		jQuery( ".ecl-accordion2__content" ).each(function( index ) {
			jQuery(this).hide();
		});


		var accordionVicino = jQuery(this).closest("h3").next();
		accordionVicino.show();

	});

});

</script>
