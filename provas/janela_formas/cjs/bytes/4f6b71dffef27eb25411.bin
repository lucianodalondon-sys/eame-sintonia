    "67a33751-3fb9-48ff-be24-a04bee786c1c": {
      "@type": "slate", 
      "plaintext": "Le indicazioni riportate nei bollettini interprovinciali sono vincolanti per la Difesa Integrata Volontaria e per le aziende inserite nei programmi relativi a:\u00a0\n\u00a0- marchio Sistema Qualit\u00e0 Nazionale Produzione integrata e certificazione ACA (Dm 4890/2014);\n\u00a0- marchio regionale \u201cQualit\u00e0 Controllata\u201d (LR 28/99) - DM n.4969 del 29/8/2017 \u201cProduzione Integrata in Disciplina ambientale\u201d in applicazione del Regolamento Unione europea: 2021/2115,1308/2013 e tipi di spesa previsti dal Reg UE 2021/2115 obiettivi e) e f) (programmi operativi settore ortofrutta e patata).", 
      "value": [
        {
          "children": [
            {
              "text": "Le indicazioni riportate nei bollettini interprovinciali sono vincolanti per la Difesa Integrata Volontaria e per le aziende inserite nei programmi relativi a:\u00a0\n\u00a0- marchio Sistema Qualit\u00e0 Nazionale Produzione integrata e certificazione ACA (Dm 4890/2014);\n\u00a0- marchio regionale \u201cQualit\u00e0 Controllata\u201d (LR 28/99) - DM n.4969 del 29/8/2017 \u201cProduzione Integrata in Disciplina ambientale\u201d in applicazione del Regolamento Unione europea: 2021/2115,1308/2013 e tipi di spesa previsti dal Reg UE 2021/2115 obiettivi e) e f) (programmi operativi settore ortofrutta e patata).\u00a0"
            }
          ], 
          "styleName": "x_MsoNormal", 
          "type": "p"
        }
      ]
    }, 
    "af030b33-6df8-4f7e-8fa0-141b22326807": {
      "@type": "slate", 
      "plaintext": "I bollettini danno indicazioni coerenti con la attuale versione del Piano Strategico della PAC relativo alla programmazione 2023-2027 ai sensi del Reg. EU n. 2115/2021 e con i Disciplinari di produzione integrata in vigore.", 
      "value": [
        {
          "children": [
            {
              "text": "I bollettini danno indicazioni coerenti con la attuale versione del Piano Strategico della PAC relativo alla programmazione 2023-2027 ai sensi del Reg. EU n. 2115/2021 e con i Disciplinari di produzione integrata in vigore."
            }
          ], 
          "styleName": "x_MsoNormal", 
          "type": "p"
        }
      ]
    }, 
    "be4eeea9-b99f-43df-b0da-a9ef0224ec0d": {
      "@type": "slate", 
      "plaintext": "Le indicazioni sono da considerare come consigli per tutte le altre aziende (Difesa integrata obbligatoria, vedi Decreto 150/2012).", 
      "value": [
        {
          "children": [
            {
              "text": "Le indicazioni sono da considerare come consigli per tutte le altre aziende (Difesa integrata obbligatoria, vedi Decreto 150/2012)."
            }
          ], 
          "styleName": "x_MsoNormal", 
          "type": "p"
        }
      ]
    }
  }, 
