<body style="/*background-image: url('resources/images/background.png');
             background-repeat: no-repeat;
             background-size: cover;
             background-position: center center;
             background-attachment: fixed;*/" >
    <video autoplay muted loop style="position: fixed;
                                    right: 0;
                                    bottom: 0;
                                    min-width: 100%; 
                                    min-height: 100%;">
        <source src="resources/videos/video.mp4" type="video/mp4">
    </video>
    <div style="position: absolute;
                bottom: 40px;
                right: 3%;
                left: 3%;
                width: 94%;
                height: 80px;
                background-color:#ffffff;
                border: 5px solid #cdcdcd;
                border-radius: 8px;
                opacity: 0.8;
                filter: alpha(opacity=80);">
        <span style="position: absolute; left: 5px; top: 5px;">
            <a href="http://ariespace.com" target='_blank'><img src="resources/logos/logo_aries.jpg" height='75px'></a>
        </span>
        <span style="position: absolute; right: 5px; top: 5px;">
            <a href="http://www.simfito.org/" target="_blank"><img src="resources/logos/logo_simfito.png" height="75px"></a>
        </span>
    </div>
</body>
