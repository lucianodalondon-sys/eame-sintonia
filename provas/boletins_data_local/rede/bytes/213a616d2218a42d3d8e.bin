		function callMatchHeight(){
			//Per avere tutte le righe della stessa altezza usare "all-rows-same-height" (ex "equal-height-false")
			$('.all-rows-same-height').matchHeight({byRow: false});
			//Per avere ciascuna riga con la stessa altezza ma diverse da riga a riga usare "each-row-same-height" (ex "equal-height-true")
			$('.each-row-same-height').matchHeight({byRow: true});
		}	
